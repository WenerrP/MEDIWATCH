+javaCopiarprivate void showFamilyConnectDialog() {
+    // Cerrar cualquier diálogo previo que pueda estar abierto
+    closeActiveDialog();
+    
+    AlertDialog.Builder builder = new AlertDialog.Builder(this);
+    LayoutInflater inflater = getLayoutInflater();
