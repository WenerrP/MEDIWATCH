+    private boolean isValidPatientId(String id) {
+        if (id == null || id.isEmpty() || "current_user_id".equals(id)) {
+            return false;
+        }
+        
+        // Validación adicional: debe tener el formato correcto (6 caracteres alfanuméricos)
