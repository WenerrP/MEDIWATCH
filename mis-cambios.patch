+            }
+            
+            @Override
+            public void onScheduleActiveChanged(Schedule schedule, boolean active) {
+                // Actualizar el estado activo del horario
+                viewModel.saveSchedule(medication.getId(), schedule);
+            }
+        };
     }
 }
